<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!--
    Product.wxs — definición del MSI para Sh_Images.
  -->
  <Product
    Id="*"
    Name="Sh_Images"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="Adrián Quirós"
    UpgradeCode="37f3b815-2bae-4e7b-880a-ec41fbc1b012">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      SummaryCodepage="1252" />

    <!-- EmbedCab="yes": el CAB va embebido dentro del MSI (autocontenido).
         Sin esto, WiX genera un cab externo (cab1.cab) y el instalador
         falla con "Source file not found cab1.cab" al distribuir solo el .msi. -->
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <MajorUpgrade
      DowngradeErrorMessage="Una versión más reciente de Sh_Images ya está instalada." />

    <!-- Directorio de instalación: C:\Program Files\Sh_Images -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Sh_Images" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="Sh_Images" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Feature principal: incluye todos los componentes -->
    <Feature
      Id="MainApplication"
      Title="Sh_Images"
      Level="1">
      <ComponentRef Id="AppComponents" />
      <ComponentRef Id="FileAssociations" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Acuerdo de licencia mostrado en el instalador (MIT real, no placeholder) -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Directorio por defecto que mostrará InstallDirDlg. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Propiedades para los checkboxes opcionales (1 = marcado por defecto) -->
    <Property Id="ASSOCIATE_EXTENSIONS" Value="1" />
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" />

    <!--
      UI de instalación estándar con selección de carpeta (WixUI_InstallDir).
      El UIRef DEBE estar dentro de <UI> para que los <Publish> que
      redirigen InstallDirDlg.Next → OptionalFeaturesDlg apliquen correctamente.
      También redirigimos ExitDialog.Finish → DoAction LaunchApplication
      (el ExitDialog estándar solo hace EndDialog).
    -->
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionalFeaturesDlg">
        1
      </Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX
      </Publish>
    </UI>

    <!-- Custom action "Lanzar Sh_Images" — WixShellExec. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lanzar Sh_Images" />
    <Property Id="WixShellExecTarget" Value="[#ShImagesExe]" />
    <CustomAction
      Id="LaunchApplication"
      BinaryKey="WixCA"
      DllEntry="WixShellExec"
      Impersonate="yes" />
  </Product>
</Wix>
