---
source: src/core/shortcuts.rs
assertion_line: 359
expression: s
---
[bindings.open]
key = "key_o"
modifiers = "ctrl"

[bindings.prev]
key = "arrow_left"
modifiers = "none"

[bindings.next]
key = "arrow_right"
modifiers = "none"

[bindings.rotate_cw]
key = "close_bracket"
modifiers = "ctrl"

[bindings.rotate_ccw]
key = "open_bracket"
modifiers = "ctrl"

[bindings.fit]
key = "key_f"
modifiers = "none"

[bindings.fullscreen]
key = "f11"
modifiers = "none"

[bindings.toggle_theme]
key = "key_t"
modifiers = "ctrl"

[bindings.toggle_sidebar]
key = "key_h"
modifiers = "none"

[bindings.toggle_info]
key = "key_i"
modifiers = "none"

[bindings.toggle_slideshow]
key = "key_f5"
modifiers = "none"

[bindings.slideshow_faster]
key = "comma"
modifiers = "none"

[bindings.slideshow_slower]
key = "period"
modifiers = "none"

[bindings.edit_shortcuts]
key = "key_k"
modifiers = "ctrl"

[bindings.video_play_pause]
key = "space"
modifiers = "none"

[bindings.video_seek_forward]
key = "arrow_right"
modifiers = "ctrl"

[bindings.video_seek_backward]
key = "arrow_left"
modifiers = "ctrl"

[bindings.video_volume_up]
key = "arrow_up"
modifiers = "ctrl"

[bindings.video_volume_down]
key = "arrow_down"
modifiers = "ctrl"

[bindings.video_toggle_mute]
key = "key_m"
modifiers = "none"
